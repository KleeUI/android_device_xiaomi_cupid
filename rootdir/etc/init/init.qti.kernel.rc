# Bring up only the hardware providers needed by early Android services in the
# synchronous path. Load the generated device manifest in parallel so an
# optional camera, media, input, IPA or WLAN probe cannot stall PID 1.
on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -b -s --all=/vendor/lib/modules/modules.load.cupid
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -b -s --all=/vendor/lib/modules/modules.load

# Device probes may publish their remoteproc controls after modprobe returns.
# Wait for each control in an independent bounded worker so early-boot remains
# non-blocking while the firmware partitions finish mounting.
on early-boot
    exec_background u:r:vendor_qti_init_shell_bg:s0 -- /vendor/bin/klee-wait-write.sh /sys/kernel/boot_adsp/boot 1 60
    exec_background u:r:vendor_qti_init_shell_bg:s0 -- /vendor/bin/klee-wait-write.sh /sys/kernel/boot_cdsp/boot 1 60
    exec_background u:r:vendor_qti_init_shell_bg:s0 -- /vendor/bin/klee-wait-write.sh /sys/kernel/boot_slpi/boot 1 60

# CVP is an optional media provider from the background module stage. Do not
# make its probe or firmware availability part of the early-boot dependency.
on boot
    exec_background u:r:vendor_qti_init_shell_bg:s0 -- /vendor/bin/klee-wait-write.sh /sys/devices/virtual/cvp/cvp/boot 1 60
