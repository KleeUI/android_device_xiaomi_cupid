# Load only the hardware entry points used by Cupid. Keep this list beside the
# generated dependency metadata so Android modprobe resolves every entry from
# the same vendor_dlkm configuration directory.
on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -b -s --all=/vendor/lib/modules/modules.load.cupid

# The firmware partitions are mounted by early-fs and the loader modules above
# create these controls synchronously. Start each remote processor before its
# userspace HAL reaches the hardware.
on early-boot
    write /sys/kernel/boot_adsp/boot 1
    write /sys/kernel/boot_cdsp/boot 1
    write /sys/devices/virtual/cvp/cvp/boot 1
    write /sys/kernel/boot_slpi/boot 1
