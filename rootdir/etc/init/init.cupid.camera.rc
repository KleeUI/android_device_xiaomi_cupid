# The kernel module manifest lives in vendor_dlkm. Android first-stage init
# only consumes the vendor-ramdisk manifest, so explicitly load the mounted
# vendor_dlkm set before HAL classes start. This includes the audio route,
# ADSP and codec drivers required by PAL to register an ALSA sound card.
on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -b -s --all=/vendor/lib/modules/modules.load
