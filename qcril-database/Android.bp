// Build the immutable qcril seed from the separately versioned stock migration
// package. The SQL remains device-owned proprietary input; Klee owns only the
// deterministic builder and its compatibility defaults.
sh_binary_host {
    name: "klee_build_qcril_db",
    src: "build_qcril_db.sh",
}

genrule {
    name: "qcrilNrDb_generated",
    tools: [
        "klee_build_qcril_db",
        "sqlite3",
    ],
    srcs: [
        "//vendor/xiaomi/sm8450-qcril:proprietary_rildb_other_sql_files",
        "//vendor/xiaomi/sm8450-qcril:proprietary_rildb_config_sql_files",
        "klee_radio_defaults.sql",
    ],
    out: ["qcrilNr.db"],
    cmd: "$(location klee_build_qcril_db) " +
        "$(location sqlite3) $(out) $(in)",
}

prebuilt_etc {
    name: "qcrilNrDb_vendor",
    vendor: true,
    sub_dir: "qcril_database",
    src: ":qcrilNrDb_generated",
    filename: "qcrilNr.db",
}
