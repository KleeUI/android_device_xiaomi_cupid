// Qualcomm remote processors use an immutable vendor-side link map to reach
// writable calibration data, shared state, firmware, and crash dumps. Keep the
// topology device-owned: the targets live on persist/data or mounted firmware
// partitions, while this file only creates links in the generated vendor image.

// msm/adsp
install_symlink {
    name: "cupid_rfs_msm_adsp_hlos",
    vendor: true,
    installed_location: "rfs/msm/adsp/hlos",
    symlink_target: "/mnt/vendor/persist/hlos_rfs/shared",
}

install_symlink {
    name: "cupid_rfs_msm_adsp_ramdumps",
    vendor: true,
    installed_location: "rfs/msm/adsp/ramdumps",
    symlink_target: "/data/vendor/tombstones/rfs/lpass",
}

install_symlink {
    name: "cupid_rfs_msm_adsp_readonly_firmware",
    vendor: true,
    installed_location: "rfs/msm/adsp/readonly/firmware",
    symlink_target: "/vendor/firmware_mnt",
}

install_symlink {
    name: "cupid_rfs_msm_adsp_readonly_vendor_firmware",
    vendor: true,
    installed_location: "rfs/msm/adsp/readonly/vendor/firmware",
    symlink_target: "/vendor/firmware",
}

install_symlink {
    name: "cupid_rfs_msm_adsp_readwrite",
    vendor: true,
    installed_location: "rfs/msm/adsp/readwrite",
    symlink_target: "/mnt/vendor/persist/rfs/msm/adsp",
}

install_symlink {
    name: "cupid_rfs_msm_adsp_shared",
    vendor: true,
    installed_location: "rfs/msm/adsp/shared",
    symlink_target: "/mnt/vendor/persist/rfs/shared",
}

