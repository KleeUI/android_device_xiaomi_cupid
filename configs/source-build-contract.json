  "required_proprietary_inputs": [
    {
      "name": "gnss-qti-extension",
      "reason": "vendor.qti.gnss-service.so has no public ABI-equivalent replacement in the selected source trees."
    },
    {
      "name": "xiaomi-thermal-policy",
      "reason": "The public QTI HAL does not implement mi_thermald policy or Xiaomi's mi_thermal_interface.ko. Missing kernel bridges are recorded in source-module-gaps.json; this contract does not restore or authorize a mismatched prebuilt kernel module."
    },
    {
      "name": "graphics-and-camera-private-runtime",
      "reason": "CamX/ISP, Adreno userspace, tuning and selected private display extensions remain separate from the source-built display HAL."
    },
    {
      "name": "remote-processor-firmware",
      "reason": "DSP, modem, GNSS, Wi-Fi, Bluetooth and GPU firmware and board calibration are proprietary hardware inputs."
    },
    {
      "name": "audio-private-inputs",
      "reason": "DSP firmware, ACDB calibration, private codec/effect extensions and the paired listener/libadsprpc remain proprietary. The small audioadsprpcd loader can be source-built separately."
    }
  ]
