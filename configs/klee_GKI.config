# Qualcomm gralloc allocates scanout buffers from this uncached system heap.
CONFIG_QCOM_DMABUF_HEAPS_SYSTEM_UNCACHED=y

# Let ueventd satisfy firmware requests after the kernel's direct lookup
# misses. Android's firmware_directories already includes /vendor/firmware,
# keeping vendor firmware access in the ueventd SELinux domain.
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
