ro.hardware.camera=xiaomi
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.hardware.fp.udfps=true
ro.vendor.qti.va_aosp.support=1
ro.vendor.qti.va_odm.support=1

# Cupid exposes two modem stacks through qcrilNrd.  qcrilNrd is intentionally
# disabled in its stock init fragment until this property selects the modem
# count, so an omitted default leaves both SIM slots permanently offline.
persist.radio.multisim.config=dsds
ro.telephony.default_network=33,33
telephony.active_modems.max_count=2
telephony.lteOnCdmaDevice=1

# Keep DMA-BUF heaps while using the gralloc4 private-handle ABI expected by
# Cupid's proprietary camera and GPU userspace. TARGET_QTI_GRALLOC4_COMPAT
# selects the matching legacy allocator and excludes mapper5/SnapAlloc.
vendor.gralloc.use_dma_buf_heaps=1
vendor.gralloc.enable_snapalloc=0
