<libraries>
    <!-- Source AudioReach IPC registrars must be loaded before the core HAL. -->
    <library name="agmservice"
            libraryName="libagmipcservice.so"
            method="registerService"
            mandatory="true" />
    <library name="palservice"
            libraryName="libpalipcservice.so"
            method="registerService"
            mandatory="true" />
    <library name="audio-core"
            libraryName="libaudiocorehal.qti.so"
            method="registerServices"
            mandatory="false" />
    <library name="audio-core-default"
            libraryName="libaudiocorehal.default.so"
            method="registerServices"
            mandatory="true" />
    <library name="audio-effects"
            libraryName="libaudioeffecthal.qti.so"
            method="registerService"
            mandatory="false" />
    <library name="bluetooth-audio"
            libraryName="android.hardware.bluetooth.audio-impl.so"
            method="createIBluetoothAudioProviderFactory"
            mandatory="true" />
    <library name="sthal"
            libraryName="libsoundtriggerhal.qti.so"
            method="createISoundTriggerFactory"
            mandatory="false" />
</libraries>
