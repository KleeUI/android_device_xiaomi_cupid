// Cupid launched with Android S FCM level 6 and its stock 5.10.81 kernel.
// Android 17 no longer installs the legacy level-6 framework matrix globally,
// so keep the device-specific compatibility fragment here.  The module adds
// the level-6 kernel requirements generated from the AOSP S 5.10 config and
// declares the legacy Bluetooth audio and device-private Xiaomi HALs exposed
// by the stock vendor manifests.
vintf_compatibility_matrix {
    name: "cupid_framework_compatibility_matrix.6.xml",
    stem: "compatibility_matrix.6.xml",
    srcs: [
        "compatibility_matrix.6.xml",
    ],
    kernel_configs: [
        "kernel_config_s_5.10",
    ],
}

// The stock vendor image contains several proprietary HIDL implementations
// whose source .hal files are not published.  Register their interface names
// with the build-time init verifier while continuing to use the ABI-matched
// prebuilt implementations from vendor/xiaomi.
prebuilt_hidl_interfaces {
    name: "cupid_prebuilt_hidl_interfaces",
    interfaces: [
        "com.qualcomm.qti.dpm.api@1.0::IdpmQmi",
        "vendor.display.color@1.0::IDisplayColor",
        "vendor.display.color@1.1::IDisplayColor",
        "vendor.display.color@1.2::IDisplayColor",
        "vendor.display.color@1.3::IDisplayColor",
        "vendor.display.color@1.4::IDisplayColor",
        "vendor.display.color@1.5::IDisplayColor",
        "vendor.display.color@1.6::IDisplayColor",
        "vendor.display.color@1.7::IDisplayColor",
        "vendor.display.postproc@1.0::IDisplayPostproc",
        "vendor.qti.hardware.AGMIPC@1.0::IAGM",
        "vendor.qti.hardware.alarm@1.0::IAlarm",
        "vendor.qti.hardware.pal@1.0::IPAL",
        "vendor.qti.hardware.dsp@1.0::IDspService",
        "vendor.qti.hardware.qconfig@1.0::IQConfig",
        "vendor.qti.hardware.qccsyshal@1.2::IQccsyshal",
        "vendor.qti.hardware.vpp@2.0::IHidlVppService",
        "vendor.xiaomi.hardware.bgservice@1.0::IBGService",
        "vendor.xiaomi.hardware.campostproc@1.0::IMiPostProcService",
        "vendor.xiaomi.hardware.mlipay@1.1::IMlipayService",
        "vendor.xiaomi.hardware.quickcamera@1.0::IQuickCameraService",
    ],
}

// fs_mgr can only mount a partition onto a directory that already exists in
// the immutable vendor image.  These hidden sentinels make Soong create the
// four mount points; the mounted filesystems cover them during normal boot.
install_symlink {
    name: "cupid_firmware_mnt_mountpoint",
    vendor: true,
    installed_location: "firmware_mnt/.klee_mountpoint",
    symlink_target: "/dev/null",
}

install_symlink {
    name: "cupid_dsp_mountpoint",
    vendor: true,
    installed_location: "dsp/.klee_mountpoint",
    symlink_target: "/dev/null",
}

install_symlink {
    name: "cupid_bt_firmware_mountpoint",
    vendor: true,
    installed_location: "bt_firmware/.klee_mountpoint",
    symlink_target: "/dev/null",
}

install_symlink {
    name: "cupid_vm_system_mountpoint",
    vendor: true,
    installed_location: "vm-system/.klee_mountpoint",
    symlink_target: "/dev/null",
}

// The stock firmware partition keeps the QCA6490 payloads at its image root,
// while the upstream WLAN driver requests them through a chip-specific path.
// Keep the immutable firmware in place and expose only compatibility links in
// vendor so firmware_class can resolve both layouts.
install_symlink {
    name: "cupid_qca6490_amss20_firmware",
    vendor: true,
    installed_location: "firmware/qca6490/amss20.bin",
    symlink_target: "/vendor/firmware_mnt/image/amss20.bin",
}

install_symlink {
    name: "cupid_qca6490_bdwlan_firmware",
    vendor: true,
    installed_location: "firmware/qca6490/bdwlan.elf",
    symlink_target: "/vendor/firmware_mnt/image/bdwlan.elf",
}

install_symlink {
    name: "cupid_qca6490_regdb_firmware",
    vendor: true,
    installed_location: "firmware/qca6490/regdb_xiaomi.bin",
    symlink_target: "/vendor/firmware_mnt/image/regdb_xiaomi.bin",
}

install_symlink {
    name: "cupid_qca6490_board_firmware",
    vendor: true,
    installed_location: "firmware/qca6490/bd_l3gf.elf",
    symlink_target: "/vendor/firmware_mnt/image/bd_l3gf.elf",
}

install_symlink {
    name: "cupid_qca6490_wifi_config",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6490/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6490/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "cupid_qca6490_wlan_mac",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6490/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/qca6490/wlan_mac.bin",
}
