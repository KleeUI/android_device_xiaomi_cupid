# The DTS tree is linked into kernel_platform/msm-kernel.  Techpack sources
# live in the Android source root, not beside the kernel repository as they did
# in the legacy sm8450 layout.
KLEE_QCOM_OPEN_SOURCE_ROOT := $(srctree)/../../vendor/qcom/opensource
DTC_INCLUDE += $(KLEE_QCOM_OPEN_SOURCE_ROOT)/camera-kernel
KBUILD_DTC_INCLUDE += $(KLEE_QCOM_OPEN_SOURCE_ROOT)/camera-kernel

include $(srctree)/$(src)/config/parrot.mk
include $(srctree)/$(src)/config/waipio.mk

always-y	:= $(dtbo-y) $(dtb-y)
subdir-y	:= $(dts-dirs)
clean-files	:= *.dtb *.dtbo
