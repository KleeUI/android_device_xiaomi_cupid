@@ -52,6 +52,19 @@ struct pmic_glink_client *pmic_glink_register_client(struct device *dev,
 int pmic_glink_unregister_client(struct pmic_glink_client *client);
 int pmic_glink_write(struct pmic_glink_client *client, void *data,
 			size_t len);
+/* Result is per invocation, not a delivery guarantee or receive fence. */
+int pmic_glink_write_status(struct pmic_glink_client *client, void *data,
+			size_t len, bool *transport_entered);
+/* Process context only. Caller owns client/priv lifetime through return. */
+/* admit runs under registry/client locks; no sends or RX waits inside it. */
+/* Logical notify ordering only: not a physical reset or RX-generation fence. */
+int pmic_glink_trywrite_admitted(struct pmic_glink_client *client, void *data,
+        int len, bool *transport_entered,
+        int (*admit)(void *priv), void *priv);
+/* Native backend payload-entry report; false does not clear old quarantine. */
+int pmic_glink_trywrite_report(struct pmic_glink_client *client, void *data,
+        int len, bool *may_have_sent,
+        int (*admit)(void *priv), void *priv);
 #else
 static inline struct pmic_glink_client *pmic_glink_register_client(
 			struct device *dev,
@@ -70,6 +83,32 @@ static inline int pmic_glink_write(struct pmic_glink_client *client, void *data,
 {
 	return -ENODEV;
 }
+static inline int pmic_glink_write_status(struct pmic_glink_client *client,
+		void *data, size_t len, bool *transport_entered)
+{
+	if (!transport_entered)
+		return -EINVAL;
+	*transport_entered = false;
+	return -ENODEV;
+}
+static inline int pmic_glink_trywrite_admitted(
+        struct pmic_glink_client *client, void *data, int len,
+        bool *transport_entered, int (*admit)(void *priv), void *priv)
+{
+    if (!transport_entered)
+        return -EINVAL;
+    *transport_entered = false;
+    return -ENODEV;
+}
+static inline int pmic_glink_trywrite_report(
+        struct pmic_glink_client *client, void *data, int len,
+        bool *may_have_sent, int (*admit)(void *priv), void *priv)
+{
+    if (!may_have_sent)
+        return -EINVAL;
+    *may_have_sent = false;
+    return -ENODEV;
+}
 #endif
 
 #endif
