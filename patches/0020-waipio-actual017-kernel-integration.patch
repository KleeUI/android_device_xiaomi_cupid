+static ssize_t cpu_limits_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t len)
+{
+    unsigned int cpu, max;
+    char input[64], *value, *sep;
+    int ret;
+    if (!len || len >= sizeof(input) || memchr(buf, 0, len)) return -EINVAL;
+    memcpy(input, buf, len);
+    input[len] = 0;
+    value = strim(input);
+    if (strncmp(value, "cpu", 3)) return -EINVAL;
+    value += 3;
+    sep = strchr(value, ' ');
+    if (!sep) return -EINVAL;
+    *sep++ = 0;
+    if (kstrtouint(value, 10, &cpu) || kstrtouint(strim(sep), 10, &max)) return -EINVAL;
+    ret = cpu_limits_set_level(cpu, max);
+    return ret ? ret : len;
+}
