+/*
+ * On boards declaring a Type-C role provider, charger firmware has no USB
+ * SCOPE/CONNECTOR_TYPE ABI. UCSI already owns the connector and role switch.
+ * Read the actual role provider; never manufacture a cached/default scope.
+ * Taking references per read avoids a charger/DWC3 probe dependency. The
+ * provider device lock prevents driver unbind while its get callback runs.
+ */
+static int battery_chg_typec_scope(struct battery_chg_dev *bcdev, int *scope)
+{
+	struct device_node *provider;
+	struct platform_device *pdev;
+	struct module *owner;
+	struct usb_role_switch *sw;
+	enum usb_role role;
+	int rc;
+
+	provider = of_parse_phandle(bcdev->dev->of_node,
+							   "qcom,typec-usb-role-switch", 0);
+	if (!provider)
+		return -EINVAL;
+	if (!of_property_read_bool(provider, "usb-role-switch")) {
+		of_node_put(provider);
+		return -EINVAL;
+	}
+	pdev = of_find_device_by_node(provider);
+	of_node_put(provider);
+	if (!pdev)
+		return -ENODEV;
+
+	if (!device_trylock(&pdev->dev)) {
+		put_device(&pdev->dev);
+		return -EAGAIN;
+	}
+	if (!pdev->dev.driver) {
+		rc = -ENODEV;
+		goto out;
+	}
+	/* The role API warns, but still returns a switch, on module-get failure.
+	 * Pin the supplier first so the inner API's module reference is valid.
+	 */
+	owner = pdev->dev.driver->owner;
+	if (!try_module_get(owner)) {
+		rc = -ENODEV;
+		goto out;
+	}
+	sw = usb_role_switch_find_by_fwnode(dev_fwnode(&pdev->dev));
+	if (IS_ERR(sw)) {
+		rc = PTR_ERR(sw);
+		goto put_owner;
+	}
+	if (!sw) {
+		rc = -ENODEV;
+		goto put_owner;
+	}
+	role = usb_role_switch_get_role(sw);
+	usb_role_switch_put(sw);
+	rc = 0;
+	switch (role) {
+	case USB_ROLE_DEVICE:
+		*scope = POWER_SUPPLY_SCOPE_DEVICE;
+		break;
+	case USB_ROLE_HOST:
+		*scope = POWER_SUPPLY_SCOPE_SYSTEM;
+		break;
+	case USB_ROLE_NONE:
+		*scope = POWER_SUPPLY_SCOPE_UNKNOWN;
+		break;
+	default:
+		rc = -ENODATA;
+	}
+put_owner:
+	module_put(owner);
+out:
+	device_unlock(&pdev->dev);
+	put_device(&pdev->dev);
+	return rc;
+}
