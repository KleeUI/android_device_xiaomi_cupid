+
+static void screen_state_for_thermal_callback(enum panel_event_notifier_tag tag,
+    struct panel_event_notification *notification, void *client_data)
+{
+    int state;
+    if (!notification || notification->notif_data.early_trigger ||
+        tag != PANEL_EVENT_NOTIFICATION_PRIMARY || READ_ONCE(stopping)) return;
+    switch (notification->notif_type) {
+    case DRM_PANEL_EVENT_UNBLANK: state = 1; break;
+    case DRM_PANEL_EVENT_BLANK: case DRM_PANEL_EVENT_BLANK_LP: state = 0; break;
+    default: return;
+    }
+    mutex_lock(&screen_lock);
+    if (!screen_known || screen_state != state) {
+        screen_state = state; screen_known = true;
+        sysfs_notify(&mi_thermal_dev.dev->kobj, NULL, "screen_state");
+    }
+    mutex_unlock(&screen_lock);
+}
+
+static int thermal_check_panel(struct device_node *np)
+{
+    int i, count = of_count_phandle_with_args(np, "panel", NULL);
+    struct device_node *node;
+    struct drm_panel *panel;
+    if (count <= 0) return -ENODEV;
+    for (i = 0; i < count; i++) {
+        node = of_parse_phandle(np, "panel", i);
+        if (!node) continue;
+        panel = of_drm_find_panel(node);
+        of_node_put(node);
+        if (!IS_ERR(panel)) { prim_panel = panel; return 0; }
+    }
+    return -EPROBE_DEFER;
+}
+
+static int create_thermal_message_node(void)
+{
+    static const struct attribute_group group = { .attrs = mi_thermal_dev_attr_group };
+    static const struct attribute_group *groups[] = { &group, NULL };
+    mi_thermal_dev.dev = thermal_message_register(groups);
+    if (IS_ERR(mi_thermal_dev.dev)) {
+        int ret = PTR_ERR(mi_thermal_dev.dev);
+        mi_thermal_dev.dev = NULL;
+        return ret;
+    }
+    return 0;
+}
+
+static void destroy_thermal_message_node(void)
+{
+    thermal_message_unregister(mi_thermal_dev.dev);
+    mi_thermal_dev.dev = NULL;
+}
+
+static void screen_state_check(struct work_struct *work)
+{
+    struct device_node *node;
+    int ret;
+    if (READ_ONCE(stopping)) return;
+    node = of_find_node_by_name(NULL, "thermal-screen");
+    if (!node) return;
+    ret = thermal_check_panel(node);
+    of_node_put(node);
+    if (!ret && !cookie) {
+        cookie = panel_event_notifier_register_thermal(prim_panel,
+            screen_state_for_thermal_callback, NULL);
+        if (IS_ERR(cookie)) { ret = PTR_ERR(cookie); cookie = NULL; }
+    }
+    if (ret && !READ_ONCE(stopping))
+        queue_delayed_work(screen_state_wq, &screen_state_dw, 5 * HZ);
+}
+
+/* Keep probe resident: CPU policies can become ready after module load. */
+static int mi_thermal_interface_probe(struct platform_device *pdev)
+{
+    int ret;
+    WRITE_ONCE(stopping, false);
+    screen_known = false;
+    ret = of_parse_thermal_message();
+    if (ret) return ret;
+    ret = cpu_thermal_init();
+    if (ret) goto free_sensor;
+    screen_state_wq = create_singlethread_workqueue("screen_state_wq");
+    if (!screen_state_wq) { ret = -ENOMEM; goto free_cpu; }
+    INIT_DELAYED_WORK(&screen_state_dw, screen_state_check);
+    ret = create_thermal_message_node();
+    if (ret) goto free_work;
+    queue_delayed_work(screen_state_wq, &screen_state_dw, 5 * HZ);
+    return 0;
+free_work:
+    destroy_workqueue(screen_state_wq); screen_state_wq = NULL;
+free_cpu:
+    destory_thermal_cpu();
+free_sensor:
+    kfree(board_sensor); board_sensor = NULL;
+    return ret;
+}
+
+static int mi_thermal_interface_remove(struct platform_device *pdev)
+{
+    WRITE_ONCE(stopping, true);
+    cancel_delayed_work_sync(&screen_state_dw);
+    destroy_workqueue(screen_state_wq);
+    screen_state_wq = NULL;
+    if (cookie) panel_event_notifier_unregister(cookie);
+    cookie = NULL;
+    prim_panel = NULL;
+    destroy_thermal_message_node();
+    destory_thermal_cpu();
+    kfree(board_sensor);
+    board_sensor = NULL;
+    return 0;
+}
+
+/*
+ * A private compatibility device provides driver-core deferred probing.
+ * The existing thermal-message DT lookup and ABI remain unchanged.
+ * A loaded module is not ready until thermal_message_register() succeeds.
+ */
+static struct platform_driver mi_thermal_interface_driver = {
+    .probe = mi_thermal_interface_probe,
+    .remove = mi_thermal_interface_remove,
+    .driver = {
+        .name = "mi-thermal-interface",
+        .suppress_bind_attrs = true,
+    },
+};
+static struct platform_device *mi_thermal_interface_pdev;
+
+static int __init mi_thermal_interface_init(void)
+{
+    int ret;
+
+    ret = platform_driver_register(&mi_thermal_interface_driver);
+    if (ret) return ret;
+    mi_thermal_interface_pdev = platform_device_register_simple(
+        "mi-thermal-interface", PLATFORM_DEVID_NONE, NULL, 0);
+    if (IS_ERR(mi_thermal_interface_pdev)) {
+        ret = PTR_ERR(mi_thermal_interface_pdev);
+        mi_thermal_interface_pdev = NULL;
+        platform_driver_unregister(&mi_thermal_interface_driver);
+        return ret;
+    }
+    return 0;
+}
+
+static void __exit mi_thermal_interface_exit(void)
+{
+    platform_device_unregister(mi_thermal_interface_pdev);
+    mi_thermal_interface_pdev = NULL;
+    platform_driver_unregister(&mi_thermal_interface_driver);
+}
+
+module_init(mi_thermal_interface_init);
+module_exit(mi_thermal_interface_exit);
+
+MODULE_AUTHOR("Xiaomi thermal team");
+MODULE_DESCRIPTION("Xiaomi thermal control  interface");
+MODULE_LICENSE("GPL v2");
