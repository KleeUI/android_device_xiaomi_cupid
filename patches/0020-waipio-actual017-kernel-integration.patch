+static int of_parse_thermal_message(void)
+{
+    struct device_node *np;
+    const char *name;
+    int ret;
+    np = of_find_node_by_name(NULL, "thermal-message");
+    if (!np) return -ENODEV;
+    ret = of_property_read_string(np, "board-sensor", &name);
+    if (!ret) {
+        board_sensor = kstrdup(name, GFP_KERNEL);
+        if (!board_sensor) ret = -ENOMEM;
+    }
+    of_node_put(np);
+    return ret;
+}
