diff --git a/kernel_platform/msm-kernel/include/linux/soc/qcom/pmic_glink.h b/kernel_platform/msm-kernel/include/linux/soc/qcom/pmic_glink.h
index ea0b102a484bef2ca11a9bdfae915ec563dc9673..f956d2c6aab22c7c3e404628f510ff8a0f842d5e 100644
