index 0000000000000000000000000000000000000000..9b22e003adaa139626684e363997c0914ef1a297
--- /dev/null
+++ b/kernel_platform/msm-kernel/include/linux/rpmsg/qcom_glink_tx_status.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _QCOM_GLINK_TX_STATUS_H
+#define _QCOM_GLINK_TX_STATUS_H
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct rpmsg_endpoint;
+/* Native GLINK only. Caller owns endpoint lifetime. Process context only.
+ * False: this invocation did not enter the payload pipe writer.
+ * True: payload may have been sent, regardless of return value.
+ * Not a delivery, firmware-application, response-freshness or reset fence.
+ */
+#if IS_REACHABLE(CONFIG_RPMSG_QCOM_GLINK)
+int qcom_glink_trysend_status(struct rpmsg_endpoint *ept, void *data, int len,
+                             bool *may_have_sent);
+#else
+static inline int qcom_glink_trysend_status(struct rpmsg_endpoint *ept,
+        void *data, int len, bool *may_have_sent)
+{
+    if (!may_have_sent)
+        return -EINVAL;
+    *may_have_sent = false;
+    return -EOPNOTSUPP;
+}
+#endif
+#endif
