+static int cpufreq_set_level(struct cpufreq_device *cdev, unsigned long state)
+{
+    int ret;
+    if (state > cdev->max_level) return -EINVAL;
+    if (cdev->cpufreq_state == state) return 0;
+    ret = freq_qos_update_request(&cdev->qos_req, cdev->freq_table[state].frequency);
+    if (ret < 0) return ret;
+    cdev->cpufreq_state = state;
+    return 0;
+}
+
+static int cpu_limits_set_level(unsigned int cpu, unsigned int max_freq)
+{
+    struct cpufreq_device *cdev;
+    unsigned int level;
+    int ret = -ENODEV;
+    if (cpu >= nr_cpu_ids) return -EINVAL;
+    mutex_lock(&cpufreq_list_lock);
+    list_for_each_entry(cdev, &cpufreq_dev_list, node) {
+        if (!cpumask_test_cpu(cpu, cdev->policy->related_cpus)) continue;
+        ret = -ERANGE;
+        for (level = 0; level <= cdev->max_level; level++) {
+            if (max_freq >= cdev->freq_table[level].frequency) {
+                ret = cpufreq_set_level(cdev, level); break;
+            }
+        }
+        break;
+    }
+    mutex_unlock(&cpufreq_list_lock);
+    return ret;
+}
+
+static unsigned int find_next_max(struct cpufreq_frequency_table *table,
+				  unsigned int prev_max)
+{
+	struct cpufreq_frequency_table *pos;
+	unsigned int max = 0;
+	cpufreq_for_each_valid_entry (pos, table) {
+		if (pos->frequency > max && pos->frequency < prev_max)
+			max = pos->frequency;
+	}
+	return max;
+}
+
+static void destory_thermal_cpu(void);
+static int cpu_thermal_init(void)
+{
+    struct cpufreq_policy *policy;
+    struct cpufreq_device *cdev;
+    cpumask_t covered;
+    unsigned int cpu, i, freq;
+    int ret = 0;
+    cpumask_clear(&covered);
+    cpus_read_lock();
+    for_each_online_cpu(cpu) {
+        if (cpumask_test_cpu(cpu, &covered)) continue;
+        policy = cpufreq_cpu_get(cpu);
+        if (!policy) { ret = -EPROBE_DEFER; goto fail; }
+        i = cpufreq_table_count_valid_entries(policy);
+        if (!i) { cpufreq_cpu_put(policy); ret = -ENODEV; goto fail; }
+        cdev = kzalloc(sizeof(*cdev), GFP_KERNEL);
+        if (!cdev) { cpufreq_cpu_put(policy); ret = -ENOMEM; goto fail; }
+        cdev->policy = policy;
+        cdev->max_level = i - 1;
+        cdev->id = policy->cpu;
+        cdev->freq_table = kmalloc_array(i, sizeof(*cdev->freq_table), GFP_KERNEL);
+        if (!cdev->freq_table) {
+            cpufreq_cpu_put(policy); kfree(cdev); ret = -ENOMEM; goto fail;
+        }
+        for (i = 0, freq = UINT_MAX; i <= cdev->max_level; i++) {
+            freq = find_next_max(policy->freq_table, freq);
+            if (!freq) {
+                kfree(cdev->freq_table); cpufreq_cpu_put(policy);
+                kfree(cdev); ret = -EINVAL; goto fail;
+            }
+            cdev->freq_table[i].frequency = freq;
+        }
+        ret = freq_qos_add_request(&policy->constraints, &cdev->qos_req,
+                                  FREQ_QOS_MAX, FREQ_QOS_MAX_DEFAULT_VALUE);
+        if (ret < 0) {
+            kfree(cdev->freq_table); cpufreq_cpu_put(policy); kfree(cdev); goto fail;
+        }
+        cdev->cpufreq_state = UINT_MAX;
+        cpumask_or(&covered, &covered, policy->related_cpus);
+        list_add_tail(&cdev->node, &cpufreq_dev_list);
+    }
+    if (!cpumask_subset(cpu_possible_mask, &covered)) {
+        ret = -EPROBE_DEFER;
+        goto fail;
+    }
+    if (list_empty(&cpufreq_dev_list)) { ret = -ENODEV; goto fail; }
+    cpus_read_unlock();
+    return 0;
+fail:
+    cpus_read_unlock();
+    destory_thermal_cpu();
+    return ret;
+}
+
+static void destory_thermal_cpu(void)
+{
+    struct cpufreq_device *priv, *tmp;
+    mutex_lock(&cpufreq_list_lock);
+    list_for_each_entry_safe(priv, tmp, &cpufreq_dev_list, node) {
+        freq_qos_remove_request(&priv->qos_req);
+        list_del(&priv->node);
+        kfree(priv->freq_table);
+        cpufreq_cpu_put(priv->policy);
+        kfree(priv);
+    }
+    mutex_unlock(&cpufreq_list_lock);
+}
