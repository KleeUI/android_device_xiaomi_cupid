+static int nfc_begin_short_frame(struct nfc_dev *nfc_dev, u64 ven_epoch)
+{
+	struct cold_reset *reset = &nfc_dev->cold_reset;
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&reset->state_lock, flags);
+	if (nfc_i2c_ven_epoch(nfc_dev) != ven_epoch)
+		ret = -EIO;
+	else if (reset->response_expected || reset->response_claimed)
+		ret = -EBUSY;
+	else
+		reset->short_frame = true;
+	spin_unlock_irqrestore(&reset->state_lock, flags);
+	return ret;
+}
