+static void nfc_end_short_frame(struct nfc_dev *nfc_dev, u64 ven_epoch)
+{
+	struct cold_reset *reset = &nfc_dev->cold_reset;
+	unsigned long flags;
+
+	spin_lock_irqsave(&reset->state_lock, flags);
+	if (nfc_i2c_ven_epoch(nfc_dev) == ven_epoch)
+		reset->short_frame = false;
+	spin_unlock_irqrestore(&reset->state_lock, flags);
