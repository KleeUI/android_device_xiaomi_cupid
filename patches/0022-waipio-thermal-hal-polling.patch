@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+#ifndef QTI_THERMAL_SENSOR_POLLER_H
+#define QTI_THERMAL_SENSOR_POLLER_H
+
+#include <chrono>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+
+namespace aidl::android::hardware::thermal {
+
+// The owner must stop this worker before destroying the callback's state.
+class SensorPoller {
+public:
+    ~SensorPoller() { stop(); }
+
+    void start(std::chrono::milliseconds period, std::function<void()> tick) {
+        if (period.count() <= 0 || !tick)
+            throw std::invalid_argument("Invalid thermal polling configuration");
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (worker_.joinable())
+            throw std::logic_error("Thermal poller already started");
+        stopping_ = false;
+        worker_ = std::thread([this, period, tick = std::move(tick)] {
+            std::unique_lock<std::mutex> lock(mutex_);
+            while (!condition_.wait_for(lock, period, [this] { return stopping_; })) {
+                lock.unlock();
+                tick();
+                lock.lock();
+            }
+        });
+    }
+
+    void stop() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            stopping_ = true;
+        }
+        condition_.notify_all();
+        if (worker_.joinable())
+            worker_.join();
+    }
+
+private:
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    bool stopping_ = false;
+    std::thread worker_;
+};
+
+}  // namespace aidl::android::hardware::thermal
+#endif
