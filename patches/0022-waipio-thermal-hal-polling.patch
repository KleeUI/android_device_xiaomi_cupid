+void ThermalUtils::pollSensors()
+{
+	const auto now = std::chrono::steady_clock::now();
+	std::lock_guard<std::mutex> lock(sens_cb_mutex);
+	for (auto& entry : thermalConfig) {
+		auto& sensor = entry.second;
+		if (sensor.polling_interval_ms <= 0 || now < next_poll[entry.first])
+			continue;
+		next_poll[entry.first] = now +
+			std::chrono::milliseconds(sensor.polling_interval_ms);
+		if (cmnInst.read_temperature(sensor) < 0) {
+			LOG(ERROR) << "Polling sensor read failed: " << sensor.sensor_name;
+			continue;
+		}
+		Notify(sensor);
+	}
 }
 
