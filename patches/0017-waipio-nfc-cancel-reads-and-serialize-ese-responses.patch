+static void complete_response_locked(struct cold_reset *reset, int result)
+{
+	lockdep_assert_held(&reset->state_lock);
+
+	if (reset->waiting) {
+		reset->result = result;
+		WRITE_ONCE(reset->waiting, false);
+		wake_up_interruptible(&reset->read_wq);
+	}
+}
