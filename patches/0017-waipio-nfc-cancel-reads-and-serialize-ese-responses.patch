+static int prepare_response(struct cold_reset *reset,
+			    const struct ese_cold_reset_arg *request, u8 oid,
+			    bool read_locked, bool *delegated)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&reset->state_lock, flags);
+	if (reset->response_expected || reset->response_claimed) {
+		ret = -EBUSY;
+	} else if (reset->reader && !reset->reader->read_enabled) {
+		ret = -ECANCELED;
+	} else if (reset->is_crp_en &&
+		   request->src != reset->last_src_ese_prot) {
+		ret = -EACCES;
+	} else if (reset->is_crp_en &&
+		   request->sub_cmd == ESE_COLD_RESET_PROTECT_EN) {
+		/* The controller already confirmed protection for this source. */
+		ret = 1;
+	} else {
+		*delegated = reset->reader || reset->is_nfc_enabled;
+		if (!*delegated && !read_locked) {
+			ret = -EAGAIN;
+		} else {
+			reset->delegated = *delegated;
+			reset->request = *request;
+			reset->response_oid = oid;
+			reset->response_expected = true;
+			WRITE_ONCE(reset->waiting, true);
+		}
+	}
+	spin_unlock_irqrestore(&reset->state_lock, flags);
+	return ret;
+}
