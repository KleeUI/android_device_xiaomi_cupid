+static bool nfc_read_ready(struct nfc_dev *nfc_dev, struct nfc_file_ctx *ctx,
+			   u64 epoch, u64 ven_epoch)
+{
+	return !READ_ONCE(nfc_dev->i2c_dev.irq_enabled) ||
+	       gpio_get_value(nfc_dev->configs.gpio.irq) ||
+	       nfc_i2c_ven_epoch(nfc_dev) != ven_epoch ||
+	       nfc_check_read(nfc_dev, ctx, epoch);
