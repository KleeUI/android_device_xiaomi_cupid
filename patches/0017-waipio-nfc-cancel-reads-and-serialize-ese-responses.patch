+static int exchange_cold_reset(struct nfc_dev *nfc_dev,
+			       const struct ese_cold_reset_arg *request,
+			       size_t cmd_len)
+{
+	struct cold_reset *reset = &nfc_dev->cold_reset;
+	bool delegated, read_locked = false;
+	char *header = (char *)nfc_dev->kbuf;
+	long wait_ret;
+	int ret;
+	u64 ven_epoch;
+
+	lockdep_assert_held(&nfc_dev->write_mutex);
+	if (nfc_dev->nfc_state == NFC_STATE_FW_DWL)
 		return -EBUSY;
-	}
-	if (!gpio_get_value(nfc_dev->configs.gpio.ven)) {
-		dev_err(nfc_dev->nfc_device,
-				"cannot send ese cmd as NFCC powered off\n");
+	if (!gpio_get_value(nfc_dev->configs.gpio.ven))
 		return -ENODEV;
-	}
-	if (nfc_dev->cold_reset.cmd_buf == NULL)
+	if (nfc_dev->interface != PLATFORM_IF_I2C)
+		return -EOPNOTSUPP;
+
+	ret = prepare_response(reset, request, nfc_dev->write_kbuf[1],
+			       false, &delegated);
+	if (ret == -EAGAIN) {
+		if (!mutex_trylock(&nfc_dev->read_mutex))
+			return -EBUSY;
+		read_locked = true;
+		if (!nfc_i2c_read_at_frame_boundary(nfc_dev)) {
+			ret = -EBUSY;
+			goto out;
+		}
+		ret = prepare_response(reset, request, nfc_dev->write_kbuf[1],
+				       true, &delegated);
+	}
+	if (ret) {
+		if (ret == 1)
+			ret = 0;
+		goto out;
+	}
+
+	if (delegated && read_locked) {
+		mutex_unlock(&nfc_dev->read_mutex);
+		wake_up_all(&nfc_dev->read_lock_wq);
+		read_locked = false;
+	}
+
+	ven_epoch = nfc_i2c_ven_epoch(nfc_dev);
+	if (!READ_ONCE(reset->waiting)) {
+		ret = finish_response(reset, -ECANCELED, false);
+		goto out;
+	}
+
+	/* An I2C write error may still have left a command on the controller. */
+	ret = nfc_dev->nfc_write(nfc_dev, (char *)nfc_dev->write_kbuf,
+				 cmd_len, NO_RETRY);
+	if (ret != cmd_len) {
+		ret = finish_response(reset, ret < 0 ? ret : -EIO, true);
+		goto out;
+	}
+
+	if (delegated) {
+		wait_ret = wait_event_interruptible_timeout(reset->read_wq,
+			!READ_ONCE(reset->waiting),
+			msecs_to_jiffies(NCI_CMD_RSP_TIMEOUT));
+		ret = finish_response(reset,
+				      wait_ret < 0 ? wait_ret : -ETIMEDOUT,
+				      true);
+	} else {
