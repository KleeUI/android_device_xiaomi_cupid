+static int nfc_check_read(struct nfc_dev *nfc_dev, struct nfc_file_ctx *ctx,
+			  u64 epoch)
+{
+	struct cold_reset *reset = &nfc_dev->cold_reset;
+	unsigned long flags;
+	int ret = 0;
+
+	if (!ctx)
+		return 0;
+
+	spin_lock_irqsave(&reset->state_lock, flags);
+	if (!ctx->read_enabled || ctx->read_epoch != epoch)
+		ret = -ECANCELED;
+	else if (reset->reader && reset->reader != ctx &&
+		 reset->reader->read_enabled)
+		ret = -EBUSY;
+	spin_unlock_irqrestore(&reset->state_lock, flags);
+	return ret;
