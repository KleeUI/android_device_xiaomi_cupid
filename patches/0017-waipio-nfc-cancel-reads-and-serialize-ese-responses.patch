+static int nfc_i2c_recv(struct nfc_dev *nfc_dev, char *buf, size_t count,
+			int timeout, struct nfc_file_ctx *ctx, u64 epoch,
+			u64 ven_epoch, bool nonblock)
+{
+	struct platform_gpio *gpio = &nfc_dev->configs.gpio;
+	unsigned long deadline = jiffies + msecs_to_jiffies(timeout);
+	unsigned long now;
+	long waited;
+	int ret;
+	unsigned int i;
+
+	count = min_t(size_t, count, MAX_BUFFER_SIZE);
+	if (!count)
+		return 0;
+
+	while (!nonblock && !gpio_get_value(gpio->irq)) {
+		ret = nfc_check_read(nfc_dev, ctx, epoch);
+		if (ret)
+			return ret;
+		if (nfc_i2c_ven_epoch(nfc_dev) != ven_epoch ||
+		    !gpio_get_value(gpio->ven))
+			return -EIO;
+
+		i2c_enable_irq(nfc_dev);
+		if (timeout) {
+			now = jiffies;
+			waited = time_before(now, deadline) ?
+				wait_event_interruptible_timeout(nfc_dev->read_wq,
+					nfc_read_ready(nfc_dev, ctx, epoch, ven_epoch),
+					deadline - now) : 0;
+		} else {
+			waited = wait_event_interruptible(nfc_dev->read_wq,
+					nfc_read_ready(nfc_dev, ctx, epoch, ven_epoch));
+		}
