+	mutex_unlock(&nfc_dev->rx_bus_mutex);
+
+	NFCLOG_IPC(nfc_dev, false, "%s of %zu bytes, ret %d", __func__, count, ret);
+	for (i = 0; ret > 0 && i < GET_IPCLOG_MAX_PKT_LEN(ret); i++)
