-
+	if (copy_from_user(&request, u64_to_user_ptr(ioctl_arg.buf),
+			   sizeof(request)))
+		return -EFAULT;
+
+	ret = mutex_lock_interruptible(&nfc_dev->write_mutex);
+	if (ret)
+		return ret;
+
+	cmd[0] = PROP_NCI_CMD_GID;
+	switch (request.sub_cmd) {
+	case ESE_COLD_RESET_DO:
+		cmd[1] = COLD_RESET_OID;
+		cmd[2] = COLD_RESET_CMD_PL_LEN;
+		cmd_len = COLD_RESET_CMD_LEN;
+		break;
+	case ESE_COLD_RESET_PROTECT_EN:
+	case ESE_COLD_RESET_PROTECT_DIS:
+		cmd[1] = COLD_RESET_PROT_OID;
+		cmd[2] = COLD_RESET_PROT_CMD_PL_LEN;
+		cmd[3] = request.sub_cmd == ESE_COLD_RESET_PROTECT_EN;
+		cmd_len = COLD_RESET_PROT_CMD_LEN;
+		break;
+	default:
+		ret = -ENOIOCTLCMD;
+		goto out;
+	}
+
+	ret = exchange_cold_reset(nfc_dev, &request, cmd_len);
+
+out:
+	mutex_unlock(&nfc_dev->write_mutex);
 	return ret;
